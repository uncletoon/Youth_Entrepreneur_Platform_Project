NODE_ENV=production
PORT=4000
DATABASE_URL=postgresql://yersps_app:replace-with-a-long-random-app-password@127.0.0.1:5432/yersps?schema=public
DATABASE_ADMIN_URL=postgresql://yersps_pgadmin:replace-with-a-different-admin-password@127.0.0.1:5432/yersps?schema=public
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
WEB_ORIGIN=https://yersps.example.org
VITE_API_URL=/api/v1
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
APP_BASE_URL=https://yersps.example.org
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=YERSPS <no-reply@example.org>
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Remove SYSTEM_ADMIN_PASSWORD from the deployed file after the one-time bootstrap.
SYSTEM_ADMIN_NAME=System Administrator
SYSTEM_ADMIN_EMAIL=system.admin@example.org
SYSTEM_ADMIN_PASSWORD=replace-with-a-different-strong-password
SYSTEM_ADMIN_ROTATE_PASSWORD=false
