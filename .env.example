NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:4000/api/v1
DATABASE_URL=postgresql://yersps_app:YERSPS.AppDb-26!@127.0.0.1:55432/yersps
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
APP_BASE_URL=http://localhost:5173

# Optional production delivery providers. Configure SMTP for email and Twilio for SMS.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=YERSPS <no-reply@example.org>
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Used only by `npm run admin:bootstrap`. Replace the password before running it.
SYSTEM_ADMIN_NAME=System Administrator
SYSTEM_ADMIN_EMAIL=system.admin@yersps.local
SYSTEM_ADMIN_PASSWORD=replace-with-a-strong-local-password
SYSTEM_ADMIN_ROTATE_PASSWORD=false
