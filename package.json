{
  "name": "yersps",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "npm run db:generate",
    "dev": "concurrently -n web,api -c green,blue \"npm run dev:web\" \"npm run dev:api\"",
    "dev:web": "npm run dev -w @yersps/web",
    "dev:api": "npm run dev -w @yersps/api",
    "build": "npm run build -w @yersps/contracts && npm run db:generate && npm run build -w @yersps/api && npm run build -w @yersps/web",
    "typecheck": "npm run build -w @yersps/contracts && npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "playwright test",
    "db:generate": "npm run db:generate -w @yersps/api",
    "db:migrate": "npm run db:migrate -w @yersps/api",
    "db:migrate:deploy": "npm run db:migrate:deploy -w @yersps/api",
    "db:migrate:production": "node --env-file=.env.production node_modules/prisma/build/index.js migrate deploy --config apps/api/prisma.config.ts",
    "db:seed": "npm run db:seed -w @yersps/api",
    "db:seed:production": "npm run db:seed:production -w @yersps/api",
    "db:studio": "npm run db:studio -w @yersps/api",
    "db:local:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-local-postgres.ps1",
    "db:local:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop-local-postgres.ps1",
    "db:backup": "powershell -NoProfile -File scripts/backup-db.ps1",
    "db:restore": "powershell -NoProfile -File scripts/restore-db.ps1",
    "admin:bootstrap": "npm run admin:bootstrap -w @yersps/api",
    "admin:bootstrap:production": "npm run admin:bootstrap:production -w @yersps/api",
    "start:production": "node --env-file=.env.production apps/api/dist/server.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/pg": "^8.21.0",
    "argon2": "^0.45.1",
    "concurrently": "^10.0.4",
    "eslint": "^10.8.0",
    "globals": "^17.9.0",
    "pg": "^8.23.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
