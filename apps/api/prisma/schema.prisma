generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SYSTEM_ADMIN
  EXPERT
  ENTREPRENEUR
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum ExpertApprovalStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

enum BusinessStage {
  IDEA
  PREPARATION
  STARTUP
  OPERATING
  GROWTH
}

enum ClassificationStatus {
  SUGGESTED
  CONFIRMED
  DISPUTED
  ADMIN_CORRECTED
}

enum AssessmentStatus {
  DRAFT
  IN_PROGRESS
  SUBMITTED
  UNDER_REVIEW
  REVIEWED
  ARCHIVED
}

enum ReadinessLevel {
  NOT_READY
  EMERGING_READINESS
  MODERATELY_READY
  READY
  HIGHLY_READY
}

enum RiskLevel {
  HIGH_RISK
  MODERATE_RISK
  LOW_RISK
}

enum RecommendationStatus {
  NEW
  IN_PROGRESS
  COMPLETED
  DISMISSED
}

enum RecommendationSource {
  SYSTEM
  ADMIN
}

enum QuestionScope {
  CORE
  SECTOR
  STAGE
}

enum QuestionSource {
  SYSTEM_MANDATORY
  EXPERT_SUPPLEMENTAL
  LEGACY_ARCHIVED
}

enum AssessmentDomainSource {
  SYSTEM_MANDATORY
  EXPERT_SUPPLEMENTAL
  LEGACY_ARCHIVED
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  LIKERT
  BOOLEAN
  NUMBER
  CURRENCY
  SHORT_TEXT
  LONG_TEXT
  SCENARIO
  FILE_EVIDENCE
}

model User {
  id                      String               @id @default(uuid()) @db.Uuid
  fullName                String
  email                   String?              @unique
  phone                   String?              @unique
  passwordHash            String
  role                    UserRole             @default(ENTREPRENEUR)
  status                  UserStatus           @default(ACTIVE)
  consentAt               DateTime
  lastLoginAt             DateTime?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  refreshTokens           RefreshToken[]
  passwordResetTokens     PasswordResetToken[]
  entrepreneurProfile     EntrepreneurProfile?
  expertProfile           ExpertProfile?       @relation("ExpertAccount")
  expertReviews           ExpertProfile[]      @relation("ExpertReviewer")
  expertAssignments       ExpertAssignment[]   @relation("ExpertAssignee")
  entrepreneurAssignments ExpertAssignment[]   @relation("EntrepreneurAssignee")
  assignmentsCreated      ExpertAssignment[]   @relation("AssignmentCreator")
  businesses              Business[]
  assessmentSessions      AssessmentSession[]
  recommendations         Recommendation[]
  adminFeedbackGiven      AdminFeedback[]      @relation("AdminFeedbackAuthor")
  adminFeedbackReceived   AdminFeedback[]      @relation("AdminFeedbackRecipient")
  feedbackReplies         FeedbackReply[]
  notifications           Notification[]
  questionsCreated        Question[]           @relation("QuestionCreator")
  domainsCreated          AssessmentDomain[]   @relation("DomainCreator")
  auditLogs               AuditLog[]           @relation("AuditActor")

  @@index([role, status])
  @@index([createdAt])
}

model ExpertProfile {
  id                   String               @id @default(uuid()) @db.Uuid
  userId               String               @unique @db.Uuid
  expertiseField       String
  proficiencyLevel     String
  yearsOfExperience    Int
  employmentStatus     String
  workplace            String?
  position             String?
  highestQualification String
  institution          String
  certifications       String?
  professionalSummary  String
  evidenceUrl          String?
  approvalStatus       ExpertApprovalStatus @default(DRAFT)
  reviewNote           String?
  submittedAt          DateTime?
  reviewedAt           DateTime?
  reviewedById         String?              @db.Uuid
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  user                 User                 @relation("ExpertAccount", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy           User?                @relation("ExpertReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([approvalStatus, submittedAt])
}

model ExpertAssignment {
  id             String   @id @default(uuid()) @db.Uuid
  expertId       String   @db.Uuid
  entrepreneurId String   @db.Uuid
  assignedById   String?  @db.Uuid
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  expert         User     @relation("ExpertAssignee", fields: [expertId], references: [id], onDelete: Cascade)
  entrepreneur   User     @relation("EntrepreneurAssignee", fields: [entrepreneurId], references: [id], onDelete: Cascade)
  assignedBy     User?    @relation("AssignmentCreator", fields: [assignedById], references: [id], onDelete: SetNull)

  @@unique([expertId, entrepreneurId])
  @@index([expertId, active])
  @@index([entrepreneurId, active])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ipAddress String?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model EntrepreneurProfile {
  id                         String   @id @default(uuid()) @db.Uuid
  userId                     String   @unique @db.Uuid
  ageGroup                   String?
  gender                     String?
  province                   String?
  district                   String?
  sectorLocation             String?
  educationLevel             String?
  employmentStatus           String?
  entrepreneurshipExperience String?
  previousBusinessExperience String?
  relevantTraining           String?
  digitalAccess              String?
  preferredLanguage          String   @default("English")
  completionPercent          Int      @default(0)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
  user                       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Sector {
  id              String                   @id @default(uuid()) @db.Uuid
  code            String                   @unique
  name            String                   @unique
  description     String
  active          Boolean                  @default(true)
  keywords        String[]
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  businesses      Business[]
  classifications BusinessClassification[]
  questions       Question[]
  questionLinks   QuestionSector[]
}

model Business {
  id                      String                   @id @default(uuid()) @db.Uuid
  userId                  String                   @db.Uuid
  sectorId                String?                  @db.Uuid
  name                    String
  description             String
  problemSolved           String?
  productOrService        String
  targetCustomers         String?
  location                String?
  stage                   BusinessStage
  revenueModel            String?
  estimatedStartupCapital Decimal?                 @db.Decimal(14, 2)
  availableCapital        Decimal?                 @db.Decimal(14, 2)
  teamSize                Int                      @default(1)
  registrationStatus      String?
  salesChannel            String?
  mainRisks               String?
  supportingDocumentName  String?
  supportingDocumentUrl   String?
  profileCompletion       Int                      @default(0)
  archivedAt              DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  user                    User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sector                  Sector?                  @relation(fields: [sectorId], references: [id])
  classifications         BusinessClassification[]
  assessmentSessions      AssessmentSession[]
  adminFeedback           AdminFeedback[]
  recommendations         Recommendation[]

  @@index([userId, stage, archivedAt])
  @@index([sectorId])
}

model BusinessClassification {
  id                String               @id @default(uuid()) @db.Uuid
  businessId        String               @db.Uuid
  suggestedSectorId String               @db.Uuid
  confidence        Float
  explanation       String
  matchedKeywords   String[]
  status            ClassificationStatus @default(SUGGESTED)
  correctionReason  String?
  confirmedAt       DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  business          Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  suggestedSector   Sector               @relation(fields: [suggestedSectorId], references: [id])

  @@index([status, createdAt])
}

model AssessmentDomain {
  id             String                 @id @default(uuid()) @db.Uuid
  code           String                 @unique
  name           String
  description    String
  weight         Float                  @default(1)
  displayOrder   Int
  active         Boolean                @default(true)
  source         AssessmentDomainSource @default(SYSTEM_MANDATORY)
  createdById    String?                @db.Uuid
  expertiseField String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  questions      Question[]
  createdBy      User?                  @relation("DomainCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([source, active, displayOrder])
  @@index([createdById, active])
}

model Question {
  id            String               @id @default(uuid()) @db.Uuid
  code          String               @unique
  prompt        String
  helpText      String?
  type          QuestionType
  scope         QuestionScope
  domainId      String               @db.Uuid
  sectorId      String?              @db.Uuid
  stage         BusinessStage?
  required      Boolean              @default(true)
  weight        Float                @default(1)
  options       Json?
  scoringConfig Json?
  source        QuestionSource   @default(SYSTEM_MANDATORY)
  createdById   String?          @db.Uuid
  expertiseField String?
  displayOrder  Int
  active        Boolean              @default(true)
  version       Int                  @default(1)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  domain        AssessmentDomain     @relation(fields: [domainId], references: [id])
  sector        Sector?              @relation(fields: [sectorId], references: [id])
  sectors       QuestionSector[]
  createdBy     User?                @relation("QuestionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  responses     AssessmentResponse[]

  @@index([scope, active, displayOrder])
  @@index([source, active, displayOrder])
  @@index([createdById, active])
  @@index([sectorId, stage])
}

model QuestionSector {
  questionId String   @db.Uuid
  sectorId   String   @db.Uuid
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  sector     Sector   @relation(fields: [sectorId], references: [id], onDelete: Cascade)

  @@id([questionId, sectorId])
  @@index([sectorId, questionId])
}

model AssessmentSession {
  id              String               @id @default(uuid()) @db.Uuid
  userId          String               @db.Uuid
  businessId      String               @db.Uuid
  status          AssessmentStatus     @default(DRAFT)
  templateVersion String               @default("mvp-v1")
  scoringVersion  String               @default("readiness-rules-v1")
  startedAt       DateTime             @default(now())
  submittedAt     DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  business        Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  responses       AssessmentResponse[]
  result          AssessmentResult?

  @@index([userId, status])
  @@index([businessId, createdAt])
  // A partial unique index in the database permits only one DRAFT/IN_PROGRESS session per business.
}

model AssessmentResponse {
  id         String            @id @default(uuid()) @db.Uuid
  sessionId  String            @db.Uuid
  questionId String            @db.Uuid
  answer     Json
  rawScore   Float?
  maxScore   Float?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  session    AssessmentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question   Question          @relation(fields: [questionId], references: [id])

  @@unique([sessionId, questionId])
}

model AssessmentResult {
  id              String            @id @default(uuid()) @db.Uuid
  sessionId       String            @unique @db.Uuid
  overallScore    Float
  readinessLevel  ReadinessLevel
  riskLevel       RiskLevel
  domainScores    Json
  strengths       String[]
  gaps            String[]
  positiveFactors String[]
  riskFactors     String[]
  supplementalScores Json              @default("[]")
  disclaimer      String
  rulesVersion    String
  createdAt       DateTime          @default(now())
  session         AssessmentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model Recommendation {
  id            String               @id @default(uuid()) @db.Uuid
  userId        String               @db.Uuid
  businessId    String?              @db.Uuid
  title         String
  description   String
  category      String
  priority      String
  relatedDomain String?
  actionSteps   String[]
  status        RecommendationStatus @default(NEW)
  source        RecommendationSource @default(SYSTEM)
  rulesVersion  String
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  business      Business?            @relation(fields: [businessId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([businessId, createdAt])
}

model AdminFeedback {
  id             String          @id @default(uuid()) @db.Uuid
  entrepreneurId String          @db.Uuid
  adminId        String          @db.Uuid
  businessId     String?         @db.Uuid
  message        String
  createdAt      DateTime        @default(now())
  entrepreneur   User            @relation("AdminFeedbackRecipient", fields: [entrepreneurId], references: [id], onDelete: Cascade)
  admin          User            @relation("AdminFeedbackAuthor", fields: [adminId], references: [id], onDelete: Cascade)
  business       Business?       @relation(fields: [businessId], references: [id], onDelete: SetNull)
  replies        FeedbackReply[]

  @@index([entrepreneurId, createdAt])
  @@index([businessId, createdAt])
}

model FeedbackReply {
  id         String        @id @default(uuid()) @db.Uuid
  feedbackId String        @db.Uuid
  authorId   String        @db.Uuid
  message    String
  createdAt  DateTime      @default(now())
  feedback   AdminFeedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  author     User          @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([feedbackId, createdAt])
  @@index([authorId, createdAt])
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  type      String
  title     String
  message   String
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  action     String
  entityType String
  entityId   String?
  oldValues  Json?
  newValues  Json?
  reason     String?
  ipAddress  String?
  createdAt  DateTime @default(now())
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([action, createdAt])
  @@index([actorId, createdAt])
}
