{
  "name": "@yersps/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate --schema=prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --config=prisma.config.ts",
    "db:migrate:deploy": "prisma migrate deploy --config=prisma.config.ts",
    "db:seed": "prisma db seed --config=prisma.config.ts",
    "db:seed:production": "tsx --env-file=../../.env.production prisma/seed.ts",
    "admin:bootstrap": "tsx --env-file-if-exists=../../.env prisma/bootstrap-system-admin.ts",
    "admin:bootstrap:production": "tsx --env-file=../../.env.production prisma/bootstrap-system-admin.ts",
    "db:studio": "prisma studio --config=prisma.config.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@yersps/contracts": "*",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "helmet": "^8.3.0",
    "jose": "^6.2.8",
    "nodemailer": "^9.0.5",
    "pino-http": "^11.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "@types/nodemailer": "^8.0.1",
    "prisma": "^7.9.1",
    "tsx": "^4.23.5"
  }
}
